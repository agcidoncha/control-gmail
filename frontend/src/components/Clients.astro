<section class="card clients-screen">
  <div class="card-header">
    <div>
      <h2>Clientes</h2>
      <p>Contactos detectados en los mensajes de la cuenta activa.</p>
    </div>
    <span id="clientCount" class="muted" aria-label="Cargando cantidad de clientes"><span class="skeleton skeleton-inline" aria-hidden="true"></span></span>
  </div>
  <p class="clients-note">Fichas generadas con la actividad visible de la cuenta. El historial y el análisis de necesidades se consultan bajo demanda.</p>
  <div class="clients-toolbar" aria-label="Filtrar clientes">
    <label class="clients-search">
      <span>Buscar cliente</span>
      <input id="clientSearch" type="search" placeholder="correo@empresa.com" autocomplete="off" />
    </label>
    <label class="clients-page-size">
      <span>Mostrar</span>
      <select id="clientPageSize">
        <option value="10">10</option>
        <option value="25" selected>25</option>
        <option value="50">50</option>
        <option value="100">100</option>
        <option value="all">Todos</option>
      </select>
      <span>por página</span>
    </label>
  </div>
  <div id="clients" class="clients-list skeleton-list" aria-live="polite" aria-busy="true" aria-label="Cargando clientes" aria-hidden="true">
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
  </div>
  <nav id="clientPagination" class="clients-pagination" aria-label="Paginación de clientes" hidden>
    <button id="clientPrevious" type="button">Anterior</button>
    <span id="clientPageStatus" aria-live="polite"></span>
    <button id="clientNext" type="button">Siguiente</button>
  </nav>
</section>

<script is:inline src="/scripts/clients.js"></script>

<style is:global>
  .clients-screen { margin-top: 18px; }
  .clients-note { margin: 16px 0 4px; color: var(--muted); font-size: 13px; }
  .clients-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-top: 18px; padding: 12px 0; border-top: 1px solid var(--border); }
  .clients-search, .clients-page-size { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
  .clients-search { flex: 1 1 320px; }
  .clients-search span, .clients-page-size span:first-child { color: var(--ink); font-weight: 700; }
  .clients-search input, .clients-page-size select { min-height: 36px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; }
  .clients-search input { width: min(100%, 360px); padding: 8px 10px; }
  .clients-page-size select { padding: 6px 28px 6px 9px; }
  .clients-search input:focus-visible, .clients-page-size select:focus-visible, .clients-pagination button:focus-visible { outline: 3px solid var(--orange-light); outline-offset: 2px; }
  .clients-list { display: grid; gap: 0; margin-top: 16px; }
  .client-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--border); }
  .client-card:last-child { border-bottom: 0; }
  .client-summary { display: flex; align-items: baseline; flex-wrap: nowrap; gap: 6px 12px; min-width: 0; }
  .client-card strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .client-card small, .client-card p { flex: 0 0 auto; white-space: nowrap; }
  .client-card small { color: var(--muted); }
  .client-card p { margin: 0; color: var(--body-copy); font-size: 13px; }
  .client-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .client-actions button, .client-actions a { padding: 7px 10px; border: 1px solid var(--border); border-radius: 8px; color: var(--orange-dark); background: var(--warm); font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; }
  .client-actions button:hover, .client-actions button:focus-visible, .client-actions a:hover, .client-actions a:focus-visible { color: var(--ink); background: var(--orange-light); }
  .clients-pagination { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
  .clients-pagination button { padding: 7px 11px; border: 1px solid var(--border); border-radius: 8px; color: var(--orange-dark); background: var(--warm); font: inherit; font-size: 12px; cursor: pointer; }
  .clients-pagination button:disabled { cursor: not-allowed; opacity: .45; }
  .clients-pagination span { min-width: 88px; color: var(--muted); text-align: center; font-size: 13px; }
  .client-history { grid-column: 1 / -1; padding: 12px; border-top: 1px solid var(--border); }
  .client-history p { margin: 0 0 8px; }
  .client-history-message { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .client-history-message:last-child { border-bottom: 0; }
  .client-history-message strong, .client-history-message small, .client-history-message span { display: block; overflow-wrap: anywhere; }
  .client-history-message small { margin-top: 3px; color: var(--muted); }
  .client-history-message span { margin-top: 5px; white-space: pre-wrap; }
  @media (max-width: 700px) {
    .client-card { grid-template-columns: 1fr; gap: 10px; }
    .client-summary { flex-wrap: wrap; }
    .client-card strong { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
    .client-card small, .client-card p { white-space: normal; }
    .client-actions { justify-content: flex-start; }
    .clients-toolbar { align-items: stretch; flex-direction: column; gap: 10px; }
    .clients-search input { flex: 1; width: auto; }
    .clients-page-size { flex-wrap: wrap; }
  }
</style>
