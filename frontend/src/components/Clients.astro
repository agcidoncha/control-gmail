<section class="card clients-screen">
  <div class="card-header">
    <div>
      <h2>Clientes</h2>
      <p>Contactos detectados en los mensajes de la cuenta activa.</p>
    </div>
    <span id="clientCount" class="muted" aria-label="Cargando cantidad de clientes"><span class="skeleton skeleton-inline" aria-hidden="true"></span></span>
  </div>
  <p class="clients-note">Fichas generadas con la actividad visible de la cuenta. El historial y el análisis de necesidades se consultan bajo demanda.</p>
  <div class="clients-toolbar" aria-label="Filtrar clientes">
    <label class="clients-search">
      <span>Buscar cliente</span>
      <input id="clientSearch" type="search" placeholder="correo@empresa.com" autocomplete="off" />
    </label>
  </div>
  <form id="clientRangeForm" class="clients-range" aria-label="Elegir clientes y fechas">
    <div id="clientPageSizeField" class="clients-range-control clients-page-size-fixed">
      <span>Mostrar</span>
      <span>10 mensajes por página</span>
    </div>
    <label class="clients-range-control clients-date-mode-control">
      <span>Buscar por fecha</span>
      <select id="clientDateMode">
        <option value="this-month" selected>Este mes</option>
        <option value="day">Un día concreto</option>
        <option value="range">Un periodo</option>
      </select>
      <small id="clientRangeSummary" class="clients-range-summary muted">Este mes: consultando…</small>
    </label>
    <label id="clientExactDateField" class="clients-range-control" hidden>
      <span>Fecha</span>
      <input id="clientExactDate" type="date" />
    </label>
    <div id="clientDateRangeFields" class="clients-date-range" hidden>
      <label class="clients-range-control">
        <span>Desde</span>
        <input id="clientDateFrom" type="date" />
      </label>
      <label class="clients-range-control">
        <span>Hasta</span>
        <input id="clientDateTo" type="date" />
      </label>
    </div>
    <button id="applyClientRange" type="submit">Aplicar</button>
    <button id="resetClientRange" class="secondary-button" type="button" hidden>Limpiar fechas</button>
  </form>
  <div id="clients" class="clients-list skeleton-list" aria-live="polite" aria-busy="true" aria-label="Cargando clientes" aria-hidden="true">
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
  </div>
  <nav id="clientPagination" class="clients-pagination" aria-label="Paginación de clientes" hidden>
    <button id="clientPrevious" type="button">Anterior</button>
    <span id="clientPageStatus" aria-live="polite"></span>
    <button id="clientNext" type="button">Siguiente</button>
  </nav>
</section>

<script is:inline src="/scripts/clients.js"></script>

<style is:global>
  .clients-screen { margin-top: 18px; }
  .clients-note { margin: 16px 0 4px; color: var(--muted); font-size: 13px; }
  .clients-range { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin: 14px 0 4px; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-ai); }
  .clients-range [hidden] { display: none; }
  .clients-range-control { display: grid; flex: 0 0 auto; align-items: center; grid-template-columns: auto auto auto; gap: 7px; color: var(--muted); font-size: 12px; }
  .clients-page-size-fixed { grid-template-columns: auto auto; }
  .clients-range-control > span:first-child { color: var(--ink); font-weight: 700; }
  .clients-range-control select { min-height: 44px; min-width: 0; }
  .clients-range-control input { min-height: 36px; min-width: 0; padding: 7px 9px; border: 1px solid var(--border); border-radius: 8px; color: var(--ink); background: var(--surface-input); font: inherit; }
  .clients-date-mode-control { min-width: 0; grid-template-columns: auto minmax(190px, auto) auto; }
  .clients-range-summary { font-size: 11px; white-space: nowrap; }
  .clients-date-range { display: flex; flex-wrap: wrap; gap: 10px; }
  .clients-date-range .clients-range-control { grid-template-columns: auto minmax(140px, 1fr); }
  .clients-range button { min-height: 36px; padding: 7px 11px; border: 1px solid var(--border); border-radius: 8px; color: #fff; background: var(--orange); font: inherit; font-size: 12px; cursor: pointer; }
  .clients-range button.secondary-button { color: var(--orange-dark); background: var(--warm); }
  .clients-range button:hover, .clients-range button:focus-visible { background: var(--orange-dark); }
  .clients-range button.secondary-button:hover, .clients-range button.secondary-button:focus-visible { color: var(--ink); background: var(--orange-light); }
  .clients-range button:disabled { cursor: wait; opacity: .65; }
  .clients-toolbar { display: flex; align-items: center; gap: 12px; margin: 18px 0 4px; }
  .clients-search { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
  .clients-search { flex: 1 1 320px; }
  .clients-search span { color: var(--ink); font-weight: 700; }
  .clients-search input { width: min(100%, 360px); min-height: 44px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-input); color: var(--ink); font: inherit; }
  .clients-search input:focus-visible, .clients-range-control select:focus-visible, .clients-range-control input:focus-visible, .clients-pagination button:focus-visible { outline: 3px solid var(--orange-light); outline-offset: 2px; }
  .clients-list { display: grid; gap: 0; margin-top: 16px; }
  .client-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--border); }
  .client-card:last-child { border-bottom: 0; }
  .client-summary { display: flex; align-items: baseline; flex-wrap: nowrap; gap: 6px 12px; min-width: 0; }
  .client-card strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .client-card small, .client-card p { flex: 0 0 auto; white-space: nowrap; }
  .client-card small { color: var(--muted); }
  .client-card p { margin: 0; color: var(--body-copy); font-size: 13px; }
  .client-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .client-actions button, .client-actions a { padding: 7px 10px; border: 1px solid var(--border); border-radius: 8px; color: var(--orange-dark); background: var(--warm); font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; }
  .client-actions button:hover, .client-actions button:focus-visible, .client-actions a:hover, .client-actions a:focus-visible { color: var(--ink); background: var(--orange-light); }
  .clients-pagination { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
  .clients-pagination button { padding: 7px 11px; border: 1px solid var(--border); border-radius: 8px; color: var(--orange-dark); background: var(--warm); font: inherit; font-size: 12px; cursor: pointer; }
  .clients-pagination button:disabled { cursor: not-allowed; opacity: .45; }
  .clients-pagination span { min-width: 88px; color: var(--muted); text-align: center; font-size: 13px; }
  .client-history { grid-column: 1 / -1; padding: 12px; border-top: 1px solid var(--border); }
  .client-history p { margin: 0 0 8px; }
  .client-history-message { padding: 8px 0; border-bottom: 1px solid var(--border); }
  .client-history-message:last-child { border-bottom: 0; }
  .client-history-message strong, .client-history-message small, .client-history-message span { display: block; overflow-wrap: anywhere; }
  .client-history-message small { margin-top: 3px; color: var(--muted); }
  .client-history-message span { margin-top: 5px; white-space: pre-wrap; }
  @media (max-width: 700px) {
    .client-card { grid-template-columns: 1fr; gap: 10px; }
    .client-summary { flex-wrap: wrap; }
    .client-card strong { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
    .client-card small, .client-card p { white-space: normal; }
    .client-actions { justify-content: flex-start; }
    .clients-toolbar { align-items: stretch; flex-direction: column; gap: 10px; }
    .clients-search input { flex: 1; width: auto; }
    .clients-range { align-items: stretch; flex-direction: column; }
    .clients-range-control, .clients-date-range { align-items: stretch; grid-template-columns: minmax(110px, auto) minmax(0, 1fr) auto; }
    .clients-date-range .clients-range-control { grid-template-columns: minmax(110px, auto) minmax(0, 1fr); }
    .clients-range-summary { white-space: normal; }
    .clients-range-control select, .clients-range-control input { width: 100%; }
  }
</style>
