  .assistant-answer .review-note img { width: 28px; height: 28px; flex: 0 0 28px; }
  .assistant-answer .source { padding: 9px 0; border-bottom: 1px solid var(--border); }
  .assistant-answer .source:last-child { border-bottom: 0; }
  .assistant-answer .source strong, .assistant-answer .source small { display: block; }
  .assistant-answer .source small { margin-top: 3px; color: var(--muted); }
  .form-message { display: flex; align-items: center; gap: 10px; min-height: 0; margin: 4px 0 0; padding: 0; color: var(--muted); font-size: 13px; scroll-margin-top: 24px; }
  .form-message.is-loading { min-height: 48px; padding: 12px 14px; border: 1px solid var(--orange-light); border-radius: 10px; color: var(--orange-dark); background: var(--surface-alt); font-size: 14px; font-weight: 500; }
  .form-message.is-loading::before { width: 17px; height: 17px; flex: 0 0 17px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; content: ''; animation: assistant-spinner .75s linear infinite; }
  .form-message.is-loading::after { content: ''; animation: assistant-thinking 1.4s steps(4, end) infinite; }
  @keyframes assistant-spinner { to { transform: rotate(360deg); } }
  @keyframes assistant-thinking { 0%, 24% { content: ''; } 25%, 49% { content: '.'; } 50%, 74% { content: '..'; } 75%, 100% { content: '...'; } }
