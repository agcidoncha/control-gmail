  .assistant-confirm-dialog { width: min(100%, 560px); padding: 26px; border: 1px solid var(--border); border-radius: 16px; color: var(--ink); background: var(--panel); box-shadow: 0 24px 70px rgba(0, 0, 0, .22); }
  .assistant-confirm-dialog h3 { margin: 0; font-size: 20px; }
  .assistant-confirm-dialog > p { margin: 8px 0 0; color: var(--muted); font-size: 13px; }
