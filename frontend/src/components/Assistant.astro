<section class="card assistant-screen">
  <div class="card-header">
    <div>
      <h2>Consultar a la IA</h2>
      <p>Pregunta sobre la actividad comercial de tu cuenta autorizada.</p>
    </div>
    <div class="assistant-header-actions">
      <span id="assistantConnectionStatus" class="status-pill status-neutral" role="status" aria-live="polite">Comprobando conexión…</span>
      <a class="button-link secondary-button assistant-config-link" href="/settings/ai">Configurar conexión IA</a>
    </div>
  </div>

  <form id="assistantForm" class="assistant-form">
    <div class="assistant-form-left">
      <div class="assistant-intro">
        <strong>Asistente comercial</strong>
        <p>Analiza tus correos y propone acciones. Las acciones sobre Gmail se ejecutan desde la bandeja y siempre requieren una decisión explícita.</p>
      </div>
      <label for="assistantQuestion">¿Qué quieres revisar?</label>
      <textarea id="assistantQuestion" placeholder="Ejemplo: ¿Qué seguimientos pendientes detectas?" required></textarea>
      <div id="assistantMessage" class="form-message" role="status" aria-live="polite"></div>
    </div>

    <div class="assistant-form-right">
      <div id="assistantClientSection" class="assistant-client-picker">
        <div>
          <label for="assistantClient">Cliente a analizar</label>
          <p class="analysis-help">Elige un cliente para analizar solo sus conversaciones. Si no eliges ninguno, se revisará el conjunto disponible.</p>
        </div>
        <label class="assistant-client-search-label" for="assistantClientSearch">Buscar cliente</label>
        <input id="assistantClientSearch" type="search" placeholder="Escribe un correo para localizarlo…" autocomplete="off" />
        <div id="assistantClientResults" class="assistant-client-results" role="listbox" aria-label="Clientes encontrados" aria-live="polite" hidden></div>
        <select id="assistantClient" class="assistant-client-native-select" aria-describedby="assistantClientStatus" tabindex="-1">
          <option value="" selected disabled>Selecciona un cliente</option>
          <option value="__all__">Todos los clientes (análisis general)</option>
        </select>
        <p id="assistantClientStatus" class="analysis-cost-notice" role="status" aria-live="polite">Cargando clientes detectados…</p>
      </div>

      <div class="analysis-window">
        <div>
          <label for="analysisRange">Periodo que analizará la IA</label>
          <p class="analysis-help">La bandeja completa sigue disponible. Este periodo solo limita los mensajes que se envían al modelo.</p>
        </div>
        <select id="analysisRange" aria-describedby="analysisCostNotice">
          <option value="30" selected>Último mes (recomendado)</option>
          <option value="90">Últimos 3 meses</option>
          <option value="180">Últimos 6 meses</option>
          <option value="365">Último año</option>
          <option value="custom">Rango personalizado</option>
        </select>
        <label for="analysisScope">Alcance del buzón</label>
        <select id="analysisScope" aria-describedby="analysisCostNotice">
          <option value="mailbox" selected>Bandeja y enviados (recomendado)</option>
          <option value="all">Todos los mensajes (incluye archivados)</option>
          <option value="spam">Spam</option>
        </select>
        <div id="analysisCustomDates" class="analysis-custom-dates" hidden>
          <label>Desde <input id="analysisFrom" type="date" /></label>
          <label>Hasta <input id="analysisTo" type="date" /></label>
        </div>
        <p id="analysisCostNotice" class="analysis-cost-notice" role="status" aria-live="polite">Por defecto se analizan los últimos 30 días para controlar el consumo de IA.</p>
      </div>
      <div class="assistant-actions">
        <button id="assistantSubmit" type="submit" disabled>Analizar correos</button>
        <button class="secondary-button assistant-preset" type="button" title="Resume los hilos y destaca decisiones, compromisos y próximos pasos." data-assistant-prompt="Resúmeme las conversaciones largas y destaca decisiones, compromisos y próximos pasos.">Resumir conversaciones y próximos pasos</button>
        <button class="secondary-button assistant-preset" type="button" title="Detecta qué necesita cada cliente y separa los hechos de las suposiciones." data-assistant-prompt="Interpreta las necesidades de cada cliente a partir de las conversaciones y separa hechos de inferencias.">Detectar necesidades de clientes</button>
      </div>
      <button id="assistantReset" class="secondary-button assistant-reset-button" type="button">Nueva consulta</button>
    </div>
  </form>

  <article id="assistantAnswer" class="assistant-answer" hidden aria-live="polite"></article>

  <div id="assistantLoadingModal" class="assistant-loading-modal" hidden role="status" aria-live="polite" aria-atomic="true">
    <div class="assistant-loading-dialog" role="alertdialog" aria-modal="true" aria-labelledby="assistantLoadingTitle" aria-describedby="assistantLoadingDescription">
      <span class="assistant-loading-spinner" aria-hidden="true"></span>
      <h3 id="assistantLoadingTitle">La IA está trabajando</h3>
      <p id="assistantLoadingDescription">Actualizando Gmail y preparando el análisis…</p>
      <span class="assistant-loading-dots" aria-hidden="true"></span>
    </div>
  </div>

  <div id="assistantConfirmModal" class="assistant-confirm-modal" hidden role="dialog" aria-modal="true" aria-labelledby="assistantConfirmTitle" aria-describedby="assistantConfirmDescription">
    <div class="assistant-confirm-dialog">
      <h3 id="assistantConfirmTitle">Confirma la consulta</h3>
      <p id="assistantConfirmDescription">Antes de continuar, revisa qué información se enviará a la IA.</p>
      <blockquote id="assistantConfirmQuestion"></blockquote>
      <div id="assistantConfirmDetails" class="assistant-confirm-details"></div>
      <p class="assistant-confirm-warning">La consulta puede consumir crédito de IA. ¿Quieres ejecutarla?</p>
      <div class="assistant-confirm-actions">
        <button id="assistantConfirmCancel" class="secondary-button" type="button">Cancelar</button>
        <button id="assistantConfirmAccept" type="button">Confirmar análisis</button>
      </div>
    </div>
  </div>
</section>

<script is:inline src="/scripts/assistant.js"></script>

<style is:global>
  .assistant-screen { margin-top: 18px; }
  .assistant-header-actions { display: flex; align-items: center; gap: 10px; }
  .assistant-header-actions .status-pill,
  .assistant-header-actions .assistant-config-link { display: inline-flex; align-items: center; justify-content: center; width: 176px; min-height: 38px; box-sizing: border-box; padding: 10px 14px; border-radius: 10px; font-size: 12px; font-weight: 500; white-space: nowrap; }
  .assistant-config-link { color: var(--orange-dark); background: var(--warm); border: 1px solid var(--border); }
  .assistant-config-link:hover { color: var(--ink); background: var(--orange-light); }
  .assistant-form { display: grid; grid-template-columns: minmax(0, .88fr) minmax(420px, 1.12fr); gap: 20px; align-items: start; width: 100%; max-width: none; margin-top: 22px; }
  .assistant-form-left, .assistant-form-right { display: grid; gap: 9px; min-width: 0; }
  .assistant-intro { margin-top: 0; padding: 15px 16px; border-radius: 12px; background: var(--panel-dark); color: #fff; }
  .assistant-intro strong { display: block; font-size: 16px; }
  .assistant-intro p { margin: 5px 0 0; color: #C7BFBB; font-size: 13px; }
  .assistant-form label { font-size: 13px; font-weight: 500; }
  .assistant-form textarea { width: 100%; min-height: 150px; margin-top: 0; border: 1px solid var(--border); background: #fff; color: var(--ink); }
  .assistant-client-picker { display: grid; gap: 8px; margin-top: 0; padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-ai); scroll-margin-top: 24px; }
  .assistant-client-picker > div:first-child { display: grid; gap: 3px; }
  .assistant-client-search-label { margin-top: 2px; }
  .assistant-client-picker input[type='search'] { width: 100%; min-height: 42px; padding: 9px 13px; border: 1px solid var(--border); border-radius: 10px; color: var(--ink); background: var(--surface-input); font: inherit; }
  .assistant-client-picker input[type='search']:focus-visible { outline: 3px solid rgba(240, 162, 79, .2); outline-offset: 1px; }
