  .status-pill.status-neutral { color: var(--muted); background: #EAE6E2; }
  .status-pill.status-warning { color: var(--orange-dark); background: #FFF1E2; }
  @media (max-width: 900px) { .assistant-form { grid-template-columns: 1fr; } .assistant-actions { display: flex; flex-wrap: wrap; } .assistant-actions button { width: auto; } }
  @media (max-width: 640px) { .assistant-actions { align-items: stretch; flex-direction: column; } .assistant-actions a, .assistant-actions button { width: 100%; } .assistant-reset-button { justify-self: stretch; width: 100%; } .assistant-header-actions { align-items: stretch; flex-direction: column; width: 100%; } .assistant-header-actions .status-pill, .assistant-header-actions .assistant-config-link { width: 100%; } .assistant-header-actions a { text-align: center; } .assistant-answer-toolbar { align-items: stretch; } .assistant-print-button { width: 100%; } .card-header { flex-direction: column; } }
