    .assistant-answer h4 { color: #9a5715 !important; }
    .assistant-answer .review-note { color: #8b4c12 !important; background: #fff1e2 !important; break-inside: avoid; }
    .assistant-answer .source { break-inside: avoid; border-color: #ccc !important; }
  }
  @media (prefers-reduced-motion: reduce) { .assistant-loading-spinner, .assistant-loading-dots::after { animation: none; } }
</style>
