  .assistant-loading-modal[hidden] { display: none; }
  .assistant-loading-dialog { width: min(100%, 430px); padding: 30px 28px 26px; border: 1px solid var(--border); border-radius: 16px; color: var(--ink); background: var(--panel); box-shadow: 0 24px 70px rgba(0, 0, 0, .22); text-align: center; }
