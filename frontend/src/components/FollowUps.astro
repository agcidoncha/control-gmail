<section class="card follow-ups-screen">
  <div class="card-header">
    <div>
      <h2>Seguimientos pendientes</h2>
      <p>Mensajes enviados sin una respuesta posterior, agrupados por hilo.</p>
    </div>
    <span id="followUpCount" class="muted" aria-label="Cargando cantidad de seguimientos"><span class="skeleton skeleton-inline" aria-hidden="true"></span></span>
  </div>

  <div class="follow-up-tools">
    <input id="followUpSearch" type="search" placeholder="Buscar cliente o asunto…" aria-label="Buscar seguimientos" />
    <select id="followUpAge" aria-label="Filtrar por antigüedad">
      <option value="all">Cualquier antigüedad</option>
      <option value="7">Más de 7 días</option>
      <option value="30">Más de 30 días</option>
    </select>
  </div>

  <div id="followUps" class="skeleton-list follow-ups-list" aria-live="polite" aria-busy="true" aria-label="Cargando seguimientos" aria-hidden="true">
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
    <div class="skeleton-list-item"><span class="skeleton skeleton-line title"></span><span class="skeleton skeleton-line meta"></span><span class="skeleton skeleton-line short"></span></div>
  </div>
</section>

<script is:inline src="/scripts/follow-ups.js"></script>

<style is:global>
  .follow-ups-screen { margin-top: 18px; }
  .follow-up-tools { display: flex; gap: 12px; margin: 18px 0 4px; }
  .follow-up-tools input, .follow-up-tools select { min-width: 0; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px; font: inherit; background: #fff; color: var(--ink); }
  .follow-up-tools input { flex: 1; }
  .follow-ups-list { display: grid; gap: 0; margin-top: 10px; }
  .follow-up { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .follow-up:last-child { border-bottom: 0; }
  .follow-up strong, .follow-up small, .follow-up p { display: block; overflow-wrap: anywhere; }
  .follow-up small { margin-top: 4px; color: var(--muted); }
  .follow-up p { margin: 7px 0 0; color: #4E4745; font-size: 13px; }
  .follow-up-side { display: flex; align-items: flex-end; flex-direction: column; gap: 10px; }
  .follow-up-age { align-self: flex-end; padding: 5px 9px; border-radius: 999px; color: var(--orange-dark); background: #FFF1E2; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .follow-up-thread-button { padding: 7px 10px; background: var(--panel-dark); font-size: 12px; }
  .follow-up-thread { grid-column: 1 / -1; padding: 14px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--warm); }
  .follow-up-thread[hidden] { display: none; }
  .thread-message { padding: 10px 0; border-bottom: 1px solid var(--border); }
  .thread-message:last-child { border-bottom: 0; }
  .thread-message strong, .thread-message small, .thread-message p { display: block; }
  .thread-message small { margin-top: 3px; color: var(--muted); }
  .thread-message p { margin: 7px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .follow-up-tools { flex-direction: column; } .follow-up-tools input, .follow-up-tools select { width: 100%; } .follow-up { grid-template-columns: 1fr; gap: 10px; } .follow-up-side { align-items: flex-start; flex-direction: row; flex-wrap: wrap; } .follow-up-age { align-self: center; } }
</style>
