  .follow-up-range button { min-height: 36px; padding: 7px 11px; border: 1px solid var(--border); border-radius: 8px; color: #fff; background: var(--orange); font: inherit; font-size: 12px; cursor: pointer; }
  .follow-up-range button.secondary-button { color: var(--orange-dark); background: var(--warm); }
  .follow-up-range button:hover, .follow-up-range button:focus-visible { background: var(--orange-dark); }
  .follow-up-range button.secondary-button:hover, .follow-up-range button.secondary-button:focus-visible { color: var(--ink); background: var(--orange-light); }
  .follow-up-range button:disabled { cursor: wait; opacity: .65; }
  .follow-up-period-prompt { margin: 8px 0 0; font-size: 12px; }
