  html[data-theme='dark'] .follow-up-urgency.normal { color: var(--muted); background: var(--neutral-bg); } html[data-theme='dark'] .follow-up-urgency.attention { color: var(--orange-light); background: var(--surface-alt); } html[data-theme='dark'] .follow-up-urgency.priority { color: #FFD18C; background: #5A3B23; } html[data-theme='dark'] .follow-up-urgency.urgent { color: #FFFFFF; background: #A33C28; }
