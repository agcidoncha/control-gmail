  .follow-up-info-dialog h2 { margin: 0; font-size: 20px; }
  .follow-up-info-dialog h3 { margin: 22px 0 0; font-size: 15px; }
  .follow-up-info-dialog p { margin: 14px 0 0; color: var(--body-copy); }
