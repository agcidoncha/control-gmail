<section class="card ai-settings-screen">
  <div class="card-header">
    <div>
      <h2>Conexiones de IA</h2>
      <p>Elige si quieres usar la conexión de tu empresa o una conexión personal.</p>
    </div>
    <span id="aiConnectionAccount" class="muted">Cargando…</span>
  </div>

  <div class="connection-list">
    <article class="connection-card">
      <div class="connection-heading">
        <div>
          <span class="connection-label">Conexión de empresa</span>
          <h3 id="companyAiName">Cargando…</h3>
        </div>
        <span id="companyAiStatus" class="status-pill">—</span>
      </div>
      <p id="companyAiDescription">La administra la organización. Ningún usuario verá la clave global.</p>
    </article>

    <article id="personalAiConnection" class="connection-card personal-connection" hidden>
      <div class="connection-heading">
        <div>
          <span class="connection-label">Mi conexión personal</span>
          <h3 id="personalAiName">No conectada</h3>
        </div>
        <span id="personalAiStatus" class="status-pill status-neutral">No conectada</span>
      </div>
      <p id="personalAiDescription">La clave se cifra en el servidor y solo se usará para tus peticiones. Nunca se muestra después de guardarla.</p>
      <form id="personalAiForm" class="ai-form">
        <label for="personalAiProvider">Proveedor de mi conexión personal</label>
        <select id="personalAiProvider" name="provider" required>
          <option value="" selected disabled>Selecciona proveedor</option>
          <option value="openai">OpenAI</option>
          <option value="claude">Anthropic Claude</option>
          <option value="deepseek">DeepSeek</option>
        </select>
        <label for="personalAiModel">Modelo de mi conexión personal</label>
        <select id="personalAiModel" name="model" required disabled>
          <option value="">Selecciona primero un proveedor</option>
        </select>
        <label for="personalAiKey">Clave de API personal</label>
        <input id="personalAiKey" name="apiKey" type="password" autocomplete="new-password" placeholder="Pega aquí tu clave; no se mostrará después" required />
        <div class="ai-form-actions">
          <button type="submit">Guardar conexión personal</button>
          <button id="disconnectPersonalAi" class="secondary-button" type="button" disabled>Desconectar conexión personal</button>
        </div>
      </form>
      <p id="personalAiMessage" class="form-message" role="status" aria-live="polite"></p>
    </article>
  </div>

  <section class="ai-connection-guide" aria-label="Cómo funcionan los niveles de modelos de IA">
    <div class="ai-connection-guide-heading">
      <div>
        <strong>Cómo se sitúan los modelos</strong>
        <span>La barra activa indica el modelo que utilizará esta cuenta.</span>
      </div>
      <span id="aiGuideRole" class="ai-guide-role">Modelo en uso</span>
    </div>
    <div class="ai-model-chart" role="img" aria-label="Escala de modelos desde trabajo diario hasta casos excepcionales">
      <div class="ai-model-chart-row ai-model-chart-daily" data-ai-model-tier="daily">
        <div class="ai-model-chart-label"><strong>Trabajo diario</strong><small>OpenAI Luna · Claude Haiku · DeepSeek Flash</small></div>
        <div class="ai-model-chart-track"><span style="--bar-size: 38%"></span></div>
        <small class="ai-model-chart-note">Rápido</small>
      </div>
      <div class="ai-model-chart-row ai-model-chart-demanding" data-ai-model-tier="demanding">
        <div class="ai-model-chart-label"><strong>Trabajo exigente</strong><small>OpenAI Sol · Claude Sonnet</small></div>
        <div class="ai-model-chart-track"><span style="--bar-size: 68%"></span></div>
        <small class="ai-model-chart-note">Más precisión</small>
      </div>
      <div class="ai-model-chart-row ai-model-chart-exceptional" data-ai-model-tier="exceptional">
        <div class="ai-model-chart-label"><strong>Casos excepcionales</strong><small>OpenAI Astra · Claude Opus · DeepSeek Pro</small></div>
        <div class="ai-model-chart-track"><span style="--bar-size: 100%"></span></div>
        <small class="ai-model-chart-note">Máxima potencia</small>
      </div>
      <p class="ai-model-chart-legend">Los modelos con mayor capacidad suelen tener un coste mayor.</p>
    </div>
  </section>

  <section id="adminAiControls" class="admin-ai-controls" hidden>
    <section class="admin-ai-global-panel">
      <div class="card-header">
        <div>
          <span class="connection-label">Solo administrador</span>
          <h3>Conexiones y asignaciones</h3>
        </div>
        <span id="adminAiMessage" class="form-message" role="status" aria-live="polite"></span>
      </div>
      <div class="admin-ai-provider">
        <label for="globalAiProvider">Proveedor global activo</label>
        <select id="globalAiProvider">
          <option value="openai">OpenAI</option>
          <option value="claude">Anthropic Claude</option>
          <option value="deepseek">DeepSeek</option>
        </select>
        <label for="globalAiModel">Modelo global activo</label>
        <select id="globalAiModel" disabled>
          <option value="">Selecciona primero un proveedor</option>
        </select>
      </div>
    </section>
    <section class="admin-ai-assignment-panel">
      <div class="admin-ai-assignment-intro">
      <h4>Asignación de IA por usuario</h4>
      <p class="admin-ai-assignment-help">La conexión global es la opción común. Si activas «Puede usar IA», ese comercial conserva su proveedor y modelo aunque cambies la configuración global; si está desactivado, heredará siempre el modelo global.</p>
      </div>
      <div id="sharedAiUsers" class="shared-ai-users">Cargando usuarios…</div>
    </section>
  </section>

  <div id="aiAssignmentInfoModal" class="ai-assignment-info-modal" hidden role="dialog" aria-modal="true" aria-labelledby="aiAssignmentWarningTitle" aria-describedby="aiAssignmentInfoDescription">
    <div class="ai-assignment-info-dialog">
      <div class="ai-assignment-info-heading">
        <h2 id="aiAssignmentWarningTitle">1 comercial con una asignación distinta</h2>
      </div>
      <div id="aiAssignmentInfoDescription">
        <p id="aiAssignmentWarningText">El modelo global es openai · gpt-6-luna. Revisa estas asignaciones o sincronízalas si deben usarlo.</p>
      </div>
      <div class="ai-assignment-info-actions">
        <button id="syncGlobalAiUsers" class="secondary-button" type="button">Sincronizar con el modelo global</button>
        <button id="aiAssignmentInfoClose" class="button-link" type="button">Entendido</button>
      </div>
    </div>
  </div>

  <aside class="security-note">
    <strong>Privacidad</strong>
    <span>La conexión de IA no cambia los permisos de Gmail. Cada usuario continúa viendo únicamente su cuenta autorizada.</span>
  </aside>
</section>

<script is:inline src="/scripts/ai-settings.js"></script>

<style is:global>
  .ai-settings-screen { margin-top: 18px; }
  .connection-list { display: grid; gap: 14px; margin-top: 20px; }
  .connection-card { padding: 20px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-ai); }
  .connection-card.personal-connection { background: #fff; }
  .personal-connection .connection-label { font-weight: 500; }
  .personal-connection h3 { font-weight: 600; }
  .personal-connection .status-pill { font-weight: 500; }
  .connection-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .connection-label { display: block; margin-bottom: 5px; color: var(--orange-dark); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .connection-card h3 { margin: 0; font-size: 17px; }
  .connection-card p { max-width: 760px; margin: 10px 0 0; color: var(--muted); font-size: 13px; }
  .status-pill { padding: 5px 9px; border-radius: 999px; color: #28683B; background: #E5F3E8; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .status-pill.status-neutral { color: var(--muted); background: #EAE6E2; }
  .status-pill.status-warning { color: var(--orange-dark); background: #FFF1E2; }
  .ai-form { display: grid; gap: 8px; max-width: 650px; margin-top: 18px; }
  .ai-form label { color: var(--ink); font-size: 13px; font-weight: 500; }
  .ai-form input { width: 100%; min-width: 0; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px; color: var(--ink); background: var(--surface-input); font: inherit; }
  .ai-form select { width: 100%; min-width: 0; }
  .ai-form input:focus, .ai-form select:focus { outline: 3px solid rgba(222, 217, 211, .8); border-color: var(--border); }
  .ai-form-actions { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
  .personal-connection .ai-form-actions button { font-weight: 500; }
  .secondary-button { color: var(--orange-dark); background: var(--surface-ai); border: 1px solid var(--border); }
  .secondary-button:hover { color: var(--ink); background: var(--orange-light); }
  .secondary-button:disabled { opacity: .55; cursor: not-allowed; }
  .admin-ai-controls { display: grid; gap: 14px; margin-top: 16px; }
  .admin-ai-controls[hidden] { display: none; }
  .admin-ai-controls, .admin-ai-controls section, .shared-ai-users, .shared-ai-user-group, .shared-ai-user-group-rows, .shared-ai-user, .shared-ai-user-field { min-width: 0; }
  .shared-ai-user-email { overflow-wrap: anywhere; }
  .admin-ai-global-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 20px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-ai); }
  .admin-ai-global-panel > .card-header { min-width: 0; }
  .admin-ai-global-panel > .card-header > div { flex: 1 1 auto; min-width: 0; }
  .ai-assignment-info-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 24px; background: rgba(35, 31, 32, .42); backdrop-filter: blur(3px); }
  .ai-assignment-info-modal[hidden] { display: none; }
  .ai-assignment-info-dialog { width: min(100%, 560px); max-height: min(720px, calc(100vh - 48px)); overflow: auto; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--panel); box-shadow: 0 24px 70px rgba(35, 31, 32, .24); }
  .ai-assignment-info-heading { display: flex; align-items: center; gap: 10px; }
  .ai-assignment-info-heading img { flex: 0 0 26px; width: 26px; height: 26px; }
  .ai-assignment-info-dialog h2 { margin: 0; font-size: 20px; }
  .ai-assignment-info-dialog > #aiAssignmentInfoDescription { display: grid; gap: 8px; }
  .ai-assignment-info-dialog p { margin: 14px 0 0; color: var(--body-copy); }
  .ai-assignment-info-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .ai-assignment-info-actions button { min-width: 100px; font-size: 13px; font-weight: 500; }
  .ai-assignment-info-actions .secondary-button { color: var(--orange-dark); background: var(--surface-ai); border: 1px solid var(--border); }
  html.ai-assignment-info-open { overflow: hidden; }
  .admin-ai-assignment-panel { display: grid; gap: 12px; }
  .admin-ai-assignment-intro { padding: 20px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface-ai); }
  .admin-ai-controls h3 { margin: 0 0 5px; font-size: 17px; }
  .ai-connection-guide { display: grid; width: 100%; box-sizing: border-box; gap: 14px; margin-top: 14px; padding: 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel); }
  .ai-connection-guide-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
  .ai-connection-guide-heading > div { display: grid; gap: 3px; }
  .ai-connection-guide-heading strong { color: var(--ink); font-size: 13px; }
  .ai-connection-guide-heading span:not(.ai-guide-role) { color: var(--muted); font-size: 12px; }
  .ai-guide-role { flex: 0 0 auto; padding: 5px 8px; border-radius: 999px; color: var(--orange-dark); background: var(--surface-alt); font-size: 11px; font-weight: 600; }
  .ai-model-chart { display: grid; width: 100%; gap: 10px; padding: 4px 0; }
  .ai-model-chart-row { --chart-color: #3EAF68; display: grid; grid-template-columns: minmax(190px, 220px) minmax(0, 1fr) minmax(100px, 110px); align-items: center; gap: 12px; }
  .ai-model-chart-demanding { --chart-color: #D98A2B; }
  .ai-model-chart-exceptional { --chart-color: #7651C8; }
  .ai-model-chart-label { display: grid; gap: 2px; min-width: 0; }
  .ai-model-chart-label strong { color: var(--ink); font-size: 12px; }
  .ai-model-chart-label small, .ai-model-chart-note { color: var(--muted); font-size: 11px; line-height: 1.2; }
  .ai-model-chart-track { width: 100%; height: 13px; overflow: hidden; border-radius: 999px; background: var(--surface-ai); }
  .ai-model-chart-track span { display: block; position: relative; width: var(--bar-size); height: 100%; overflow: hidden; border-radius: inherit; background: var(--chart-color); animation: ai-chart-grow .8s ease-out both; }
  .ai-model-chart-demanding .ai-model-chart-track span { background: #D98A2B; animation-delay: .12s; }
  .ai-model-chart-exceptional .ai-model-chart-track span { background: #7651C8; animation-delay: .24s; }
  .ai-model-chart-row.is-selected .ai-model-chart-track span { background-image: linear-gradient(110deg, transparent 22%, rgba(255, 255, 255, .68) 50%, transparent 78%); background-size: 200% 100%; animation: ai-model-selection-pulse 1.7s ease-in-out infinite, ai-model-selection-shimmer 1.25s linear infinite; }
  .ai-model-chart-legend { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.35; }
  @keyframes ai-chart-grow { from { width: 0; } to { width: var(--bar-size); } }
  @keyframes ai-model-selection-pulse { 0%, 100% { opacity: .9; filter: saturate(1); box-shadow: 0 0 0 transparent; } 50% { opacity: 1; filter: saturate(1.45); box-shadow: 0 0 5px var(--chart-color), 0 0 16px var(--chart-color); } }
  @keyframes ai-model-selection-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
  @media (prefers-reduced-motion: reduce) { .ai-model-chart-track span { animation: none; } }
  .admin-ai-controls h4 { margin: 0 0 10px; font-size: 14px; }
  .admin-ai-assignment-help { margin: -4px 0 10px; color: var(--muted); font-size: 13px; }
  .admin-ai-provider { display: grid; grid-template-columns: auto minmax(180px, 240px) auto minmax(180px, 240px) minmax(0, 1fr); align-items: center; gap: 12px; }
  .admin-ai-provider label { font-size: 13px; font-weight: 500; }
  .admin-ai-provider select { width: 100%; min-width: 0; }
  .shared-ai-users { display: grid; gap: 8px; }
  .shared-ai-user-group { display: grid; gap: 8px; padding: 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-ai); }
  .shared-ai-user-group h5 { margin: 0; color: var(--orange-dark); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .shared-ai-user-group-rows { display: grid; gap: 8px; }
  .shared-ai-user { display: grid; gap: 10px; padding: 10px 0; border: 0; border-radius: 0; background: transparent; }
  .shared-ai-user + .shared-ai-user { border-top: 1px solid var(--border); }
  .shared-ai-user-heading { display: flex; align-items: center; gap: 12px; }
  .shared-ai-user-heading { justify-content: space-between; }
  .shared-ai-user-email { color: var(--ink); font-size: 15px; font-weight: 500; }
  .shared-ai-user-heading small { font-weight: 400; }
  .shared-ai-user-controls { display: grid; grid-template-columns: auto minmax(190px, 1fr) minmax(190px, 1fr); align-items: stretch; gap: 10px; }
  .shared-ai-user-controls label { color: var(--muted); font-size: 12px; font-weight: 400; }
  .shared-ai-user-controls select { width: 100%; min-width: 0; }
  .shared-ai-user-controls select:disabled { opacity: .6; }
  .shared-ai-user-field { display: grid; gap: 5px; padding: 9px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--panel); }
  .shared-ai-user small { color: var(--muted); }
  .shared-ai-user label { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-size: 13px; font-weight: 400; }
  .shared-ai-user input { accent-color: var(--orange); }
  .form-message { min-height: 20px; }
  .form-message.error { color: #A33C28; }
  .form-message.success { color: #28683B; }
  .security-note { display: grid; gap: 4px; margin-top: 16px; padding: 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface-ai); color: var(--muted); font-size: 13px; }
  .security-note strong { color: var(--ink); }
  @media (max-width: 820px) { .top-actions { flex-wrap: wrap; } }
  @media (max-width: 980px) { .admin-ai-provider { grid-template-columns: auto minmax(180px, 1fr) auto minmax(180px, 1fr); } .admin-ai-provider .muted { grid-column: 1 / -1; } }
  .ai-settings-screen .card-header { min-width: 0; }
  #aiConnectionAccount { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .ai-settings-screen .card-header { align-items: stretch; flex-direction: column; } #aiConnectionAccount { text-align: left; } .connection-heading { flex-direction: column; } .ai-form-actions { align-items: stretch; flex-direction: column; } .ai-form-actions button { width: 100%; } .admin-ai-provider { align-items: stretch; grid-template-columns: 1fr; } .admin-ai-provider .muted { grid-column: auto; } .ai-connection-guide-heading { flex-direction: column; } .ai-model-chart-row { grid-template-columns: 1fr; gap: 5px; } .ai-model-chart-track { order: 3; } .ai-model-chart-note { order: 2; } .ai-assignment-info-modal { padding: 14px; } .ai-assignment-info-dialog { padding: 20px; max-height: calc(100vh - 28px); } .ai-assignment-info-actions { align-items: stretch; flex-direction: column; } .ai-assignment-info-actions button { width: 100%; } .shared-ai-user-heading { align-items: stretch; flex-direction: column; } .shared-ai-user-controls { grid-template-columns: 1fr; } .shared-ai-user-controls select { width: 100%; } }
</style>
