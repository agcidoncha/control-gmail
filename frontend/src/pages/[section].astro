---
import AppShell from '../layouts/AppShell.astro';
import Assistant from '../components/Assistant.astro';
import Mailbox from '../components/Mailbox.astro';
import FollowUps from '../components/FollowUps.astro';
import Commitments from '../components/Commitments.astro';

const section = Astro.params.section ?? 'mailbox';
if (section === 'clients') return Astro.redirect('/mailbox?view=clients');
if (section === 'reports') return Astro.redirect('/mailbox');

const screens = {
  mailbox: { title: 'Bandeja comercial', description: 'Filtra por bandeja, asunto, remitente o contenido.', body: 'Aquí se conectará la bandeja de Gmail de la cuenta activa.' },
  'follow-ups': { title: 'Seguimientos', description: 'Mensajes enviados sin una respuesta posterior.', body: 'Aquí se mostrarán los seguimientos detectados y su antigüedad.' },
  commitments: { title: 'Compromisos', description: 'Posibles compromisos detectados en conversaciones.', body: 'Aquí se mostrarán los posibles compromisos que requieren revisión humana.' },
  clients: { title: 'Clientes', description: 'Contactos detectados en los mensajes de la cuenta activa.', body: 'Aquí se mostrará la cartera detectada a partir de recibidos y enviados.' },
  'consultar-ia': { title: 'Consultar a la IA', description: 'Pregunta sobre la actividad de tu cuenta.', body: 'Aquí se conectará el asistente comercial con los datos autorizados.' },
};
const screen = screens[Astro.params.section as keyof typeof screens] ?? screens.mailbox;
---

<AppShell>
    {section === 'mailbox' ? (
      <Mailbox />
    ) : section === 'follow-ups' ? (
      <FollowUps />
    ) : section === 'commitments' ? (
      <Commitments />
    ) : section === 'consultar-ia' ? (
      <Assistant />
    ) : (
    <section class="card screen-card">
      <div class="card-header"><div><h2>{screen.title}</h2><p>{screen.description}</p></div></div>
      <p class="screen-note">{screen.body}</p>
    </section>
  )}
</AppShell>
