---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Panel general', icon: '⌂', key: '/' },
  { href: '/mailbox', label: 'Bandeja comercial', icon: '✉', key: '/mailbox' },
  { href: '/follow-ups', label: 'Seguimientos', icon: '◷', key: '/follow-ups' },
  { href: '/commitments', label: 'Compromisos', icon: '☑', key: '/commitments' },
  { href: '/clients', label: 'Clientes', icon: '♙', key: '/clients' },
  { href: '/reports', label: 'Informes', icon: '▤', key: '/reports' },
  { href: '/assistant', label: 'Consultar a la IA', icon: '✦', key: '/assistant' },
];
const activeItem = navItems.find((item) => item.key === currentPath) ?? navItems[0];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Asistente Comercial · Gmail</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand"><img src="/brand/logo-white.svg" alt="Publicidad Segmentada TV" /></div>
        <p class="sidebar-caption">Espacio comercial</p>
        <nav class="sidebar-nav" aria-label="Secciones principales">
          {navItems.map((item) => (
            <a class:list={['nav-link', { active: item.key === activeItem.key }]} href={item.href}>
              <span><span class="nav-icon" aria-hidden="true">{item.icon}</span>{item.label}</span>
              {item.key === '/mailbox' && <b id="navMessageCount">—</b>}
              {item.key === '/follow-ups' && <b id="navFollowUpCount">—</b>}
              {item.key === '/commitments' && <b id="navCommitmentCount">—</b>}
            </a>
          ))}
        </nav>
        <div class="sidebar-footer"><span class="connection-dot"></span> Gmail · modo lectura<br /><small>Datos de la cuenta activa</small></div>
      </aside>
      <main class="main">
        <header class="topbar">
          <div><p class="eyebrow">Panel comercial</p><h1>{activeItem.label}</h1><p class="top-subtitle">Trabaja con una sola pantalla cada vez, sin desplazamientos interminables.</p></div>
          <div class="top-actions"><span id="accountChip" class="account-chip">Cuenta activa</span><a class="button-link" href="/auth/switch">Cambiar de cuenta</a></div>
        </header>
        <div class="content">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline src="/scripts/session.js"></script>
  </body>
</html>

<style is:global>
  :root { --orange: #CB7721; --orange-dark: #AD6218; --orange-light: #F0A24F; --ink: #231F20; --muted: #6F6864; --warm: #F5F2EE; --dark: #171415; --panel-dark: #252122; --border: #DED9D3; --panel: #FFFFFF; --shadow: 0 16px 38px rgba(35, 31, 32, .08); color: var(--ink); background: var(--warm); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  * { box-sizing: border-box; } body { min-width: 320px; margin: 0; line-height: 1.45; background: var(--warm); } a { color: inherit; }
  .app-shell { min-height: 100vh; display: grid; grid-template-columns: 250px minmax(0, 1fr); } .sidebar { position: sticky; top: 0; z-index: 20; display: flex; flex-direction: column; gap: 24px; height: 100vh; max-height: 100vh; overflow-y: auto; padding: 28px 18px 20px; color: #fff; background: var(--dark); } .main { min-width: 0; padding: 0 38px 72px; }
  .brand img { display: block; width: 100%; max-width: 208px; height: auto; margin-bottom: 16px; } .sidebar-caption { margin: 0; color: #B8AFAB; font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; } .sidebar-nav { display: grid; gap: 5px; }
  .nav-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 12px; border-radius: 10px; color: #E8E1DD; text-decoration: none; font-size: 14px; font-weight: 700; transition: background .15s ease, color .15s ease; } .nav-link > span:first-child { display: inline-flex; align-items: center; min-width: 0; } .nav-link:hover, .nav-link:focus-visible, .nav-link.active { color: #fff; background: rgba(240, 162, 79, .18); outline: none; } .nav-icon { width: 22px; margin-right: 8px; color: var(--orange-light); font-size: 17px; line-height: 1; text-align: center; } .nav-link b { min-width: 22px; padding: 2px 6px; border-radius: 999px; color: #fff; background: var(--orange); font-size: 11px; text-align: center; }
  .sidebar-footer { margin-top: auto; padding-top: 18px; border-top: 1px solid #4E4745; color: #B8AFAB; font-size: 12px; } .connection-dot { display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: #7EBF8B; }
  .topbar { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 30px 0 24px; border-bottom: 1px solid var(--border); } .eyebrow { margin: 0 0 6px; color: var(--orange-dark); font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; } h1, h2, p { margin-top: 0; } h1 { margin-bottom: 6px; font-size: clamp(27px, 4vw, 40px); letter-spacing: -.04em; line-height: 1.05; } h2 { margin-bottom: 5px; font-size: 19px; }
  .top-subtitle, .muted { color: var(--muted); } .top-actions { display: flex; align-items: center; gap: 12px; } .account-chip { max-width: 280px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; color: var(--muted); background: var(--panel); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .content { max-width: 1240px; margin: 0 auto; } .card { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); } .section-card { margin-top: 18px; } .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; } .card-header p { margin: 0; color: var(--muted); font-size: 13px; }
  .welcome { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 28px; margin-top: 18px; border: 1px solid var(--border); border-radius: 18px; background: #FFF7EE; box-shadow: var(--shadow); } .welcome p { margin: 0; color: #6F6864; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 18px; } .stat { padding: 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--panel); } .stat span, .stat small { display: block; color: var(--muted); font-size: 12px; } .stat strong { display: block; margin: 7px 0 2px; color: var(--orange-dark); font-size: 27px; letter-spacing: -.04em; }
  .button-link, button { display: inline-flex; align-items: center; justify-content: center; border: 0; padding: 10px 14px; border-radius: 10px; background: var(--orange); color: #fff; text-decoration: none; cursor: pointer; font: inherit; font-weight: 750; } .button-link:hover, button:hover { background: var(--orange-dark); }
  .screen-note { margin: 18px 0 0; padding: 18px; border: 1px solid var(--border); border-radius: 12px; background: var(--warm); color: var(--muted); } .screen-card { margin-top: 18px; min-height: 220px; } .screen-card form { display: grid; gap: 12px; margin-top: 18px; } textarea { width: 100%; min-height: 130px; padding: 13px; border: 1px solid var(--border); border-radius: 10px; resize: vertical; font: inherit; }
  @media (max-width: 900px) { .app-shell { grid-template-columns: 210px minmax(0, 1fr); } .main { padding: 0 24px 56px; } .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .app-shell { display: block; } .sidebar { position: sticky; height: auto; max-height: none; overflow: visible; gap: 14px; padding: 18px 14px; } .sidebar-nav { display: flex; overflow-x: auto; padding-bottom: 3px; } .nav-link { flex: 0 0 auto; } .sidebar-footer { display: none; } .main { padding: 0 14px 48px; } .topbar { align-items: flex-start; flex-direction: column; padding: 22px 0 18px; } .top-actions { width: 100%; justify-content: space-between; } .account-chip { max-width: 62%; } .welcome { align-items: flex-start; flex-direction: column; padding: 20px; } .stats { grid-template-columns: 1fr 1fr; gap: 10px; } .stat { padding: 14px; } }
</style>
