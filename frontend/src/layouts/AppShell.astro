---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/dashboard', label: 'Resumen comercial', icon: '/icons/home/resumen.svg', key: '/dashboard' },
  { href: '/mailbox', label: 'Bandeja comercial', icon: '/icons/home/bandeja.svg', key: '/mailbox' },
  { href: '/follow-ups', label: 'Seguimientos', icon: '/icons/home/seguimientos.svg', key: '/follow-ups' },
  { href: '/commitments', label: 'Compromisos', icon: '/icons/home/compromiso.svg', key: '/commitments' },
  { href: '/clients', label: 'Clientes', icon: '/icons/home/clientes.svg', key: '/clients' },
  { href: '/reports', label: 'Informes', icon: '/icons/home/reportes.svg', key: '/reports' },
  { href: '/consultar-ia', label: 'Consultar a la IA', icon: '/icons/home/consultar-ai.svg', key: '/consultar-ia' },
  { href: '/settings/ai', label: 'Configuración IA', icon: '/icons/home/settings-ai.svg', key: '/settings/ai' },
  { href: '/settings/users', label: 'Usuarios', icon: '/icons/home/usuarios.svg', key: '/settings/users', adminOnly: true },
];
const activeItem = navItems.find((item) => item.key === currentPath) ?? navItems[0];
const pageTitle = currentPath === '/settings/ai' ? 'Configuración de IA' : activeItem.label;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Asistente Comercial · Gmail</title>
  </head>
  <body>
    <div class="app-shell" data-resizable-shell>
      <aside class="sidebar">
        <div class="brand">
          <img class="brand-logo brand-logo-light" src="/brand/logo.svg" alt="Publicidad Segmentada TV" />
          <img class="brand-logo brand-logo-dark" src="/brand/logo-white.svg" alt="" aria-hidden="true" />
        </div>
        <p class="sidebar-caption">Espacio comercial</p>
        <nav class="sidebar-nav" aria-label="Secciones principales">
          {navItems.map((item) => (
            <a class:list={['nav-link', { active: item.key === activeItem.key }]} href={item.href} data-admin-only={item.adminOnly ? 'true' : 'false'} hidden={item.adminOnly ? true : undefined}>
              <span><span class:list={['nav-icon', { 'nav-icon-image': item.icon.startsWith('/') }]} style={item.icon.startsWith('/') ? `--nav-icon-url: url('${item.icon}')` : undefined} aria-hidden="true">{item.icon.startsWith('/') ? '' : item.icon}</span>{item.label}</span>
              {item.key === '/mailbox' && <b id="navMessageCount">—</b>}
              {item.key === '/follow-ups' && <b id="navFollowUpCount">—</b>}
              {item.key === '/commitments' && <b id="navCommitmentCount">—</b>}
            </a>
          ))}
        </nav>
        <div class="sidebar-footer"><span class="connection-dot"></span> Gmail · modo lectura<br /><small>Datos de la cuenta activa</small></div>
      </aside>
      <button id="sidebarResizer" class="sidebar-resizer" type="button" role="separator" aria-orientation="vertical" aria-label="Ajustar ancho del menú" aria-valuemin="18" aria-valuemax="42" aria-valuenow="24">
        <span aria-hidden="true"></span>
      </button>
      <main class="main">
        <header class="topbar">
          <div><p class="eyebrow">Panel comercial</p><h1>{pageTitle}</h1><p class="top-subtitle">Trabaja con una sola pantalla cada vez, sin desplazamientos interminables.</p></div>
          <div class="top-actions"><button id="themeToggle" class="theme-toggle" type="button" aria-pressed="false"><span class="theme-toggle-icon" aria-hidden="true">◐</span><span id="themeToggleLabel">Modo oscuro</span></button><span id="accountChip" class="account-chip">Cuenta activa</span><a class="button-link" href="/auth/switch">Cambiar de cuenta</a></div>
        </header>
        <div class="content">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline src="/scripts/session.js"></script>
    <script is:inline src="/scripts/sidebar-resizer.js"></script>
    <script is:inline src="/scripts/theme.js"></script>
  </body>
</html>

<style is:global>
  :root { --orange: #CB7721; --orange-dark: #AD6218; --orange-light: #F0A24F; --ink: #231F20; --muted: #6F6864; --warm: #F5F2EE; --dark: #171415; --panel-dark: #252122; --border: #DED9D3; --panel: #FFFFFF; --surface-soft: #FFF7EE; --surface-alt: #FFF1E2; --surface-input: #FFFFFF; --surface-hover: #FCFAF8; --body-copy: #4E4745; --success: #28683B; --success-bg: #E5F3E8; --neutral-bg: #EAE6E2; --danger: #A33C28; --shadow: 0 16px 38px rgba(35, 31, 32, .08); color: var(--ink); background: var(--warm); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  html[data-theme='dark'] { --ink: #F7F0EC; --muted: #B8AFAB; --warm: #171415; --border: #4E4745; --panel: #252122; --surface-soft: #302725; --surface-alt: #3A2B20; --surface-input: #312B2B; --surface-hover: #2B2626; --body-copy: #D8CFCA; --success: #9BD4A5; --success-bg: #1F3826; --neutral-bg: #383231; --danger: #F09A82; --shadow: 0 16px 38px rgba(0, 0, 0, .24); color-scheme: dark; }
  * { box-sizing: border-box; } body { min-width: 320px; margin: 0; line-height: 1.45; background: var(--warm); } a { color: inherit; }
  .app-shell { --sidebar-width: 24%; position: relative; min-height: 100vh; display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); } .sidebar { position: sticky; top: 0; z-index: 20; display: flex; flex-direction: column; gap: 24px; height: 100vh; max-height: 100vh; overflow-y: auto; padding: 28px 18px 20px; color: #fff; background: var(--dark); } .main { min-width: 0; padding: 0 38px 72px; }
  .sidebar-resizer { position: absolute; top: 0; bottom: 0; left: calc(var(--sidebar-width) - 6px); z-index: 30; display: flex; align-items: center; justify-content: center; width: 12px; padding: 0; border: 0; border-radius: 0; color: transparent; background: transparent; cursor: col-resize; transform: none; } .sidebar-resizer span { width: 3px; height: 48px; border-radius: 999px; background: var(--border); opacity: .45; transition: opacity .15s ease, background .15s ease; } .sidebar-resizer:hover span, .sidebar-resizer:focus-visible span, .app-shell.is-resizing .sidebar-resizer span { opacity: 1; background: var(--orange-light); } .sidebar-resizer:focus-visible { outline: 2px solid var(--orange-light); outline-offset: -2px; }
  .brand-logo { display: block; width: 100%; max-width: 208px; height: auto; margin-bottom: 16px; } .brand-logo-dark { display: none; } .sidebar-caption { margin: 0; color: #B8AFAB; font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; } .sidebar-nav { display: grid; gap: 5px; }
  .nav-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 12px; border-radius: 10px; color: #E8E1DD; text-decoration: none; font-size: 14px; font-weight: 700; transition: background .15s ease, color .15s ease; } .nav-link > span:first-child { display: inline-flex; align-items: center; min-width: 0; } .nav-link:hover, .nav-link:focus-visible, .nav-link.active { color: #fff; background: rgba(240, 162, 79, .18); outline: none; } .nav-icon { width: 25px; height: 25px; margin-right: 8px; color: var(--orange-light); font-size: 19px; line-height: 1; text-align: center; } .nav-icon-image { display: inline-block; background: currentColor; mask: var(--nav-icon-url) center / contain no-repeat; -webkit-mask: var(--nav-icon-url) center / contain no-repeat; } .nav-link b { min-width: 22px; padding: 2px 6px; border-radius: 999px; color: #fff; background: var(--orange); font-size: 11px; text-align: center; }
  html:not([data-theme='dark']) .sidebar { color: var(--ink); background: var(--panel); border-right: 1px solid var(--border); } html:not([data-theme='dark']) .brand-logo-light { display: block; } html:not([data-theme='dark']) .brand-logo-dark { display: none; } html:not([data-theme='dark']) .sidebar-caption { color: var(--muted); } html:not([data-theme='dark']) .nav-link { color: var(--ink); } html:not([data-theme='dark']) .nav-link:hover, html:not([data-theme='dark']) .nav-link:focus-visible, html:not([data-theme='dark']) .nav-link.active { color: var(--ink); background: var(--surface-alt); } html:not([data-theme='dark']) .sidebar-footer { border-top-color: var(--border); color: var(--muted); }
  html[data-theme='dark'] .brand-logo-light { display: none; } html[data-theme='dark'] .brand-logo-dark { display: block; }
  .sidebar-footer { margin-top: auto; padding-top: 18px; border-top: 1px solid #4E4745; color: #B8AFAB; font-size: 12px; } .connection-dot { display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; background: #7EBF8B; }
  .topbar { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 30px 0 24px; border-bottom: 1px solid var(--border); } .eyebrow { margin: 0 0 6px; color: var(--orange-dark); font-size: 11px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; } h1, h2, p { margin-top: 0; } h1 { margin-bottom: 6px; font-size: clamp(27px, 4vw, 40px); letter-spacing: -.04em; line-height: 1.05; } h2 { margin-bottom: 5px; }
  .top-subtitle, .muted { color: var(--muted); } .top-actions { display: flex; align-items: center; gap: 12px; } .account-chip { max-width: 280px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; color: var(--muted); background: var(--panel); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .theme-toggle { gap: 7px; padding: 9px 11px; color: var(--ink); background: var(--panel); border: 1px solid var(--border); font-size: 12px; white-space: nowrap; } .theme-toggle:hover { color: var(--ink); background: var(--surface-alt); } .theme-toggle-icon { color: var(--orange-dark); font-size: 16px; line-height: 1; }
  .content { max-width: 1240px; margin: 0 auto; } .card { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); } .section-card { margin-top: 18px; } .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; } .card-header p { margin: 0; color: var(--muted); font-size: 13px; }
  .skeleton { display: block; background: linear-gradient(90deg, var(--skeleton-base) 25%, var(--skeleton-highlight) 37%, var(--skeleton-base) 63%); background-size: 400% 100%; animation: skeleton-shimmer 1.25s ease-in-out infinite; }
  .skeleton-inline { width: 82px; height: 1em; border-radius: 999px; }
  .skeleton-list { display: grid; gap: 0; margin-top: 10px; }
  .skeleton-list-item { display: grid; gap: 11px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .skeleton-list-item:last-child { border-bottom: 0; }
  .skeleton-line { width: 100%; height: 13px; border-radius: 6px; }
  .skeleton-line.title { width: 42%; height: 16px; }
  .skeleton-line.meta { width: 28%; height: 11px; }
  .skeleton-line.short { width: 64%; }
  .skeleton-thread { display: grid; gap: 10px; padding: 12px 0; }
  @keyframes skeleton-shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
  @media (prefers-reduced-motion: reduce) { .skeleton { animation: none; } }
  .welcome { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 28px; margin-top: 18px; border: 1px solid var(--border); border-radius: 18px; background: var(--surface-soft); box-shadow: var(--shadow); } .welcome p { margin: 0; color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 18px; } .stat { padding: 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--panel); } .stat span, .stat small { display: block; color: var(--muted); font-size: 12px; } .stat strong { display: block; margin: 7px 0 2px; color: var(--orange-dark); font-size: 27px; letter-spacing: -.04em; }
  .button-link, button { display: inline-flex; align-items: center; justify-content: center; border: 0; padding: 10px 14px; border-radius: 10px; background: var(--orange); color: #fff; text-decoration: none; cursor: pointer; font: inherit; font-weight: 750; } .button-link:hover, button:hover { background: var(--orange-dark); }
  .screen-note { margin: 18px 0 0; padding: 18px; border: 1px solid var(--border); border-radius: 12px; background: var(--warm); color: var(--muted); } .screen-card { margin-top: 18px; min-height: 220px; } .screen-card form { display: grid; gap: 12px; margin-top: 18px; } textarea { width: 100%; min-height: 130px; padding: 13px; border: 1px solid var(--border); border-radius: 10px; resize: vertical; font: inherit; background: var(--surface-input); color: var(--ink); }
  html[data-theme='dark'] { --skeleton-base: #383231; --skeleton-highlight: #514945; } html:not([data-theme='dark']) { --skeleton-base: #E6E0DB; --skeleton-highlight: #F8F5F2; } html[data-theme='dark'] .sidebar { border-right: 1px solid var(--border); } html[data-theme='dark'] .nav-link { color: #E8E1DD; } html[data-theme='dark'] .message p, html[data-theme='dark'] .follow-up p, html[data-theme='dark'] .commitment p { color: var(--body-copy); } html[data-theme='dark'] .message-tools input, html[data-theme='dark'] .message-tools select, html[data-theme='dark'] .follow-up-tools input, html[data-theme='dark'] .follow-up-tools select, html[data-theme='dark'] .commitment-tools input, html[data-theme='dark'] .ai-form input, html[data-theme='dark'] .ai-form select, html[data-theme='dark'] .admin-ai-provider select, html[data-theme='dark'] .user-form input, html[data-theme='dark'] .user-form select, html[data-theme='dark'] .assistant-form textarea { background: var(--surface-input); color: var(--ink); } html[data-theme='dark'] .filter-chip, html[data-theme='dark'] .connection-card.personal-connection, html[data-theme='dark'] .shared-ai-user { background: var(--panel); color: var(--ink); } html[data-theme='dark'] .filter-chip.active, html[data-theme='dark'] .filter-chip:hover, html[data-theme='dark'] .filter-chip:focus-visible, html[data-theme='dark'] .follow-up-age, html[data-theme='dark'] .commitment-status, html[data-theme='dark'] .assistant-answer .review-note, html[data-theme='dark'] .status-pill.status-warning { background: var(--surface-alt); color: var(--orange-light); } html[data-theme='dark'] .message.is-open { background: var(--surface-hover); } html[data-theme='dark'] .thread-inline, html[data-theme='dark'] .follow-up-thread, html[data-theme='dark'] .commitment-thread, html[data-theme='dark'] .assistant-answer, html[data-theme='dark'] .authorized-user { background: var(--surface-soft); } html[data-theme='dark'] .thread-button, html[data-theme='dark'] .follow-up-thread-button, html[data-theme='dark'] .commitment-thread-button { background: #FFFFFF; color: #231F20; } html[data-theme='dark'] .thread-button:hover, html[data-theme='dark'] .follow-up-thread-button:hover, html[data-theme='dark'] .commitment-thread-button:hover { background: var(--orange-dark); color: #FFFFFF; } html[data-theme='dark'] .admin-ai-controls, html[data-theme='dark'] .security-note { background: var(--surface-soft); } html[data-theme='dark'] .status-pill { color: var(--success); background: var(--success-bg); } html[data-theme='dark'] .status-pill.status-neutral { color: var(--muted); background: var(--neutral-bg); }
  @media (max-width: 900px) { .app-shell { --sidebar-width: 28%; } .main { padding: 0 24px 56px; } .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .app-shell { display: block; } .sidebar-resizer { display: none; } .sidebar { position: sticky; height: auto; max-height: none; overflow: visible; gap: 14px; padding: 18px 14px; } .sidebar-nav { display: flex; overflow-x: auto; padding-bottom: 3px; } .nav-link { flex: 0 0 auto; } .sidebar-footer { display: none; } .main { padding: 0 14px 48px; } .topbar { align-items: flex-start; flex-direction: column; padding: 22px 0 18px; } .top-actions { width: 100%; justify-content: space-between; } .account-chip { max-width: 62%; } .welcome { align-items: flex-start; flex-direction: column; padding: 20px; } .stats { grid-template-columns: 1fr 1fr; gap: 10px; } .stat { padding: 14px; } }
</style>
