{
  "name": "control-gmail",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente comercial conectado a Gmail con soporte multiusuario.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:mysql": "tsx src/migrate-mysql.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "googleapis": "^144.0.0",
    "mysql2": "^3.24.5",
    "openai": "^4.80.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
