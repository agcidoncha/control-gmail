# Servidor
PORT=3000
HOST=127.0.0.1
DATA_STORE=local
# En el hosting: DATA_STORE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=asistente_comercial
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10
GOOGLE_CLOUD_PROJECT=
SESSION_SECRET=
ADMIN_EMAILS=
DEFAULT_ORGANIZATION_ID=org_publicidad_segmentada_tv
DEFAULT_ORGANIZATION_NAME=Publicidad Segmentada TV
ORGANIZATION_STORE_FILE=.data/organizations.json

# OAuth de Google Cloud. No incluir valores reales en Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Clave hexadecimal de 32 bytes para cifrar tokens OAuth en local.
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_FILE=.data/google-tokens.enc
# Persistencia local de mensajes e hilos Gmail. En remoto se usa Firestore.
GMAIL_STORE_FILE=.data/gmail-store.json
# Número máximo de mensajes que se sincronizan por bandeja en la primera carga.
GMAIL_SYNC_MAX_MESSAGES=250
# Tiempo mínimo entre sincronizaciones automáticas de una misma cuenta.
GMAIL_SYNC_INTERVAL_SECONDS=600
AI_CONNECTION_ENCRYPTION_KEY=
AI_CONNECTION_STORE_FILE=.data/ai-connections.enc

# IA. Usaremos un modelo económico en la primera versión.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Días que se analizan automáticamente en seguimientos, compromisos, clientes y consultas IA.
# La interfaz usa 30 días por defecto y permite ampliar el periodo bajo confirmación.
AI_ANALYSIS_DAYS=30
# Máximo de mensajes por bandeja que se recorren en un análisis (protección de coste/rendimiento).
AI_MAX_MESSAGES=30
# Límites del contexto que se envía a la IA para controlar el coste.
AI_CONTEXT_MAX_THREADS=12
AI_CONTEXT_MAX_THREAD_MESSAGES=3
AI_CONTEXT_BODY_CHARS=1200
AI_CONTEXT_SNIPPET_CHARS=500
# Proveedor compartido inicial. Las conexiones personales se añadirán cifradas en la aplicación.
DEFAULT_AI_PROVIDER=openai
FRONTEND_URL=http://localhost:4321
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
