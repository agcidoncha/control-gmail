# Servidor
PORT=3000
SESSION_SECRET=
ADMIN_EMAILS=

# OAuth de Google Cloud. No incluir valores reales en Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Clave hexadecimal de 32 bytes para cifrar tokens OAuth en local.
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_FILE=.data/google-tokens.enc

# IA. Usaremos un modelo económico en la primera versión.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=high
